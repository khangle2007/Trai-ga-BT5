<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="20dp"
        android:text="Thời gian nhập số"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="40dp"
        android:text="0%"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@null"
        android:progressDrawable="@drawable/processbar"
        android:progressTint="@null"
        app:layout_constraintEnd_toEndOf="@+id/textView"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="40dp"
        android:text="TextView"
        android:textColor="#7E7E7E"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBar" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="16dp"
        android:text="=12,231"
        android:textAlignment="textEnd"
        android:textSize="48sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:scrollHorizontally="true"
        android:ellipsize="none"
        android:gravity="end|center_vertical"
        app:layout_constraintEnd_toEndOf="@+id/textView3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/white"
        android:text="e"
        android:textColor="#84DAF2"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@id/button2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button2"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:backgroundTint="@color/white"
        android:text="μ"
        android:textColor="#84DAF2"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@id/button3"
        app:layout_constraintStart_toEndOf="@+id/button"
        app:layout_constraintTop_toTopOf="@+id/button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button3"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:backgroundTint="@color/white"
        android:text="sin"
        android:textColor="#84DAF2"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@id/button4"
        app:layout_constraintStart_toEndOf="@+id/button2"
        app:layout_constraintTop_toTopOf="@+id/button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button4"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="@color/white"
        android:text="deg"
        android:textColor="#84DAF2"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button3"
        app:layout_constraintTop_toTopOf="@+id/button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button5"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="Ac"
        android:textColor="#7C7C7C"
        android:textSize="20sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@id/imageButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button" />

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="80dp"
        android:layout_height="64dp"
        android:background="@drawable/deletebutton"
        android:contentDescription="delete"
        app:layout_constraintBottom_toBottomOf="@+id/button5"
        app:layout_constraintEnd_toStartOf="@id/button7"
        app:layout_constraintStart_toEndOf="@+id/button5"
        app:layout_constraintTop_toTopOf="@+id/button5"
        app:srcCompat="@drawable/baseline_backspace_24" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button7"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:backgroundTint="#CCF1FB"
        android:text="/"
        android:textColor="#84DAF2"
        android:textSize="38dp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@id/button8"
        app:layout_constraintStart_toEndOf="@+id/imageButton"
        app:layout_constraintTop_toTopOf="@+id/button5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button8"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#CCF1FB"
        android:paddingTop="12dp"
        android:text="*"
        android:textColor="#84DAF2"
        android:textSize="38dp"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button7"
        app:layout_constraintTop_toTopOf="@+id/button5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button9"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="7"
        android:textColor="#5290F6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@+id/button10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button10"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="8"
        android:textColor="#5290F6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@+id/button11"
        app:layout_constraintStart_toEndOf="@+id/button9"
        app:layout_constraintTop_toTopOf="@+id/button9" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button11"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="9"
        android:textColor="#5290F6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@+id/button12"
        app:layout_constraintStart_toEndOf="@+id/button10"
        app:layout_constraintTop_toTopOf="@+id/button9" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button12"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:layout_marginEnd="20dp"
        android:background="@null"
        android:backgroundTint="#CCF1FB"
        android:text="-"
        android:textColor="#84DAF2"
        android:textSize="38sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button11"
        app:layout_constraintTop_toTopOf="@+id/button9" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button13"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="4"
        android:textColor="#5290F6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/button9"
        app:layout_constraintStart_toStartOf="@+id/button9"
        app:layout_constraintTop_toBottomOf="@+id/button9" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button14"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="5"
        android:textColor="#5290F6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/button10"
        app:layout_constraintStart_toStartOf="@+id/button10"
        app:layout_constraintTop_toTopOf="@+id/button13" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button15"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="6"
        android:textColor="#5290F6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/button11"
        app:layout_constraintStart_toStartOf="@+id/button11"
        app:layout_constraintTop_toTopOf="@+id/button13" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button16"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="1"
        android:textColor="#5290F6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/button13"
        app:layout_constraintStart_toStartOf="@+id/button13"
        app:layout_constraintTop_toBottomOf="@+id/button13" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button17"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="2"
        android:textColor="#5290F6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/button14"
        app:layout_constraintStart_toStartOf="@+id/button14"
        app:layout_constraintTop_toTopOf="@+id/button16" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button18"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="3"
        android:textColor="#5290F6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/button15"
        app:layout_constraintStart_toStartOf="@+id/button15"
        app:layout_constraintTop_toTopOf="@+id/button16" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button19"
        android:layout_width="80dp"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:text="+"
        android:textColor="#84DAF2"
        android:textSize="38sp"
        app:backgroundTint="#CCF1FB"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button15"
        app:layout_constraintTop_toTopOf="@+id/button13" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button20"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="0"
        android:textColor="#5290F6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/button17"
        app:layout_constraintStart_toStartOf="@+id/button16"
        app:layout_constraintTop_toBottomOf="@+id/button16" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button21"
        android:layout_width="80dp"
        android:layout_height="72dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:text="."
        android:textColor="#5290F6"
        android:textSize="38dp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/button18"
        app:layout_constraintStart_toStartOf="@+id/button18"
        app:layout_constraintTop_toTopOf="@+id/button20" />

    <View
        android:id="@+id/view"
        android:layout_width="80dp"
        android:layout_height="112dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/elavation"
        app:layout_constraintEnd_toEndOf="@+id/button22"
        app:layout_constraintTop_toTopOf="@+id/button22" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button22"
        android:layout_width="80dp"
        android:layout_height="112dp"
        android:layout_marginEnd="20dp"
        android:text="="
        android:textColor="@color/white"
        android:textSize="38sp"
        app:backgroundTint="#5891FD"
        app:cornerRadius="16dp"
        app:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/button21"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button21" />

</androidx.constraintlayout.widget.ConstraintLayout>